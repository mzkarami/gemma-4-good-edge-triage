# Edge-Triage public demo environment template.
# Copy to .env on the deployment host and fill secret values out-of-band.
# Never commit .env or real judge tokens.

# Static demo container: keep localhost-only for public deployment.
DEMO_BIND_ADDRESS=127.0.0.1

# Guarded Live Gemma API: keep localhost-only for public deployment.
LIVE_API_BIND_ADDRESS=127.0.0.1

# Required only when starting the live API profile.
EDGE_TRIAGE_JUDGE_TOKEN=replace-with-judge-token
EDGE_TRIAGE_ALLOWED_ORIGINS=https://kaggle.nelly.work
EDGE_TRIAGE_LIVE_MODEL=1
EDGE_TRIAGE_RATE_LIMIT_PER_MINUTE=6
EDGE_TRIAGE_RATE_LIMIT_PER_DAY=60
EDGE_TRIAGE_MODEL_TIMEOUT_SECONDS=90

# Host directory mounted read-only into the live API container as /app/models.
EDGE_TRIAGE_MODEL_DIR=/path/to/edge-triage/models

# Paths inside the live API container.
EDGE_TRIAGE_MODEL_PATH=/app/models/Edge-Triage-gemma-4-E4B-it-Q3_K_M.gguf
EDGE_TRIAGE_MMPROJ_PATH=/app/models/Edge-Triage-mmproj-F16.gguf
