# Edge-Triage public demo environment template.
# Copy to .env on the deployment host and customize locally.
# Never commit .env, real tokens, private hostnames, or private model paths.

# Static demo container.
# Public deployment example: keep this localhost-only behind Caddy/nginx.
# Local LAN demo example: DEMO_BIND_ADDRESS=0.0.0.0
DEMO_BIND_ADDRESS=127.0.0.1

# Guarded Live Gemma API container.
# Public deployment example: keep this localhost-only and expose only /api/* through HTTPS.
# Local-only testing example: LIVE_API_BIND_ADDRESS=127.0.0.1
LIVE_API_BIND_ADDRESS=127.0.0.1

# Optional legacy/script token.
# Current judge flow is token-free, so empty is fine.
# Example if you intentionally enable script clients:
# Generate a value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Then paste it as: EDGE_TRIAGE_JUDGE_TOKEN=<generated-value>
EDGE_TRIAGE_JUDGE_TOKEN=

# Browser origins allowed to call the live API.
# Public example: EDGE_TRIAGE_ALLOWED_ORIGINS=https://kaggle.nelly.work
# Local examples: EDGE_TRIAGE_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
EDGE_TRIAGE_ALLOWED_ORIGINS=https://your-demo-domain.example

# Live model switch.
# 0 = fallback/smoke mode, useful before model artifacts are present.
# 1 = use the GGUF model and mmproj files from EDGE_TRIAGE_MODEL_DIR.
EDGE_TRIAGE_LIVE_MODEL=0

# Public API kill switch and resource guardrails.
# Set EDGE_TRIAGE_PUBLIC_API_ENABLED=0 to disable /api/triage without stopping the static demo.
EDGE_TRIAGE_PUBLIC_API_ENABLED=1
EDGE_TRIAGE_RATE_LIMIT_PER_MINUTE=6
EDGE_TRIAGE_RATE_LIMIT_PER_DAY=60
EDGE_TRIAGE_MAX_CONCURRENT_REQUESTS=2
EDGE_TRIAGE_MODEL_TIMEOUT_SECONDS=90
EDGE_TRIAGE_MAX_UPLOAD_MB=25
EDGE_TRIAGE_MAX_NOTE_CHARS=1000
EDGE_TRIAGE_MAX_IMAGE_PIXELS=36000000

# Host directory mounted read-only into the live API container as /app/models.
# Example after `uv run prepare.py`: EDGE_TRIAGE_MODEL_DIR=$HOME/.cache/autoresearch/models
# Example repo-local model directory: EDGE_TRIAGE_MODEL_DIR=./models
EDGE_TRIAGE_MODEL_DIR=./models

# Optional Kaggle fallbacks for users/judges without Hugging Face access.
# In Kaggle notebooks, attach datasets as Inputs and `/kaggle/input` is scanned automatically.
# Locally, install/configure the Kaggle CLI, then uncomment with your published dataset slugs.
# EDGE_TRIAGE_KAGGLE_MODEL_DATASET=<kaggle-user>/<edge-triage-model-dataset-slug>
# EDGE_TRIAGE_KAGGLE_DATASET=<kaggle-user>/<edge-triage-parquet-dataset-slug>
# KAGGLE_INPUT_DIR=/kaggle/input

# Paths inside the live API container.
EDGE_TRIAGE_MODEL_PATH=/app/models/Edge-Triage-gemma-4-E4B-it-Q3_K_M.gguf
EDGE_TRIAGE_MMPROJ_PATH=/app/models/Edge-Triage-mmproj-F16.gguf

# Optional inference tuning. Defaults match the public benchmark profile.
TRIAGE_N_CTX=933
TRIAGE_N_GPU_LAYERS=47
TRIAGE_GEN_TEMPERATURE=0.0
